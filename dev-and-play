#!/usr/bin/env bash

set -euo pipefail

print_only=false
if [[ "${1:-}" == "--print-command" ]]; then
  print_only=true
  shift
fi

requested_threads="${1:-${DIPTYCH_CODEX_THREADS:-8}}"
if [[ ! "$requested_threads" =~ ^[1-9][0-9]*$ ]]; then
  printf '%s\n' "Thread count must be a positive integer." >&2
  exit 2
fi
if (( requested_threads < 5 )); then
  printf '%s\n' "Diptych Picker needs at least 5 threads: root, monitor, and three image workers." >&2
  exit 2
fi
if (( $# > 1 )); then
  printf '%s\n' "Usage: ./dev-and-play [--print-command] [thread-count]" >&2
  exit 2
fi
repository_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
spawned_thread_limit=$((requested_threads - 1))
initial_prompt="Use \$run-diptych-picker to start or resume the local app through ./run-only and continuously run the dev-and-play loop. Keep the root session responsive while one persistent mailbox-monitor subagent owns polling and delegates fresh native-image workers. This session has $requested_threads total agent threads: reserve one for the root and one for the monitor, set workerLimit=3, and use all three worker slots whenever at least three independent jobs are pending."
command=(
  multi-cli codex/personal
  --cd "$repository_root"
  --strict-config
  --config "agents.max_concurrent_threads_per_session=$spawned_thread_limit"
  "$initial_prompt"
)

if [[ "$print_only" == true ]]; then
  printf '%q ' "${command[@]}"
  printf '\n'
  exit 0
fi

if ! command -v multi-cli >/dev/null 2>&1; then
  printf '%s\n' "multi-cli is required. Install it, run 'multi-cli codex/personal login', then retry 'npm run codex:play'." >&2
  exit 127
fi

exec "${command[@]}"
