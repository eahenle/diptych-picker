# Normal mode: the persistent Codex CLI session consumes mailbox jobs.
GENERATION_PROVIDER=agent

# Optional staged persistent-channel pool. The app waits for a ready frame,
# sends one durable job reference, and requires a matching acknowledgement.
# Durable mailbox polling remains authoritative when channels are unavailable.
# CO_PROC_GENERATION_CHANNELS=gen_a,gen_b,gen_c
# CO_PROC_GENERATION_READY_TIMEOUT_MS=100
# CO_PROC_GENERATION_ACK_TIMEOUT_MS=500
# CO_PROC_RUNTIME_ROOT=/absolute/path/to/co-proc-runtime

# Deterministic offline mode used only by automated tests.
MOCK_GENERATION_DELAY_MS=650

# Ready FIFO depth and maximum effective curated-plus-learned pool size.
CHALLENGER_BUFFER_SIZE=5
CANDIDATE_POOL_SIZE=50

# Generation-turnaround tracking plus depleted-buffer fallback pacing.
# Pool draws wait three seconds and stop after ten consecutive draws.
CHALLENGER_INITIAL_TURNAROUND_MS=300000
CHALLENGER_FALLBACK_DELAY_MS=3000
CHALLENGER_FALLBACK_MAX_CONSECUTIVE=10

# Optional: bypass tracked seed PNGs and request a generated initial pair.
GENERATE_INITIAL_CANDIDATES=false

# Relative to the repository root; state, mailbox files, and assets are ignored.
LOCAL_DATA_DIR=.local-data
