# Normal mode: the persistent Codex CLI session consumes mailbox jobs.
GENERATION_PROVIDER=agent

# Deterministic offline mode used only by automated tests.
MOCK_GENERATION_DELAY_MS=650

# Optional: bypass tracked seed PNGs and request a generated initial pair.
GENERATE_INITIAL_CANDIDATES=false

# Relative to the repository root; state, mailbox files, and assets are ignored.
LOCAL_DATA_DIR=.local-data
